[user]
	email = v.sadeghy@gmail.com
	name = vsadeghy
[alias]
	aliases = !git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\=\\/

	dl = -c diff.external=difft log -p --ext-diff
	ds = -c diff.external=difft show --ext-diff
	df = -c diff.external=difft diff

	s = status -sb
	st = status
	co = checkout
	staash = stash --all
	blaame = blame -wCCC
	l = log --oneline --decorate
	ll = log --oneline --graph --decorate
	lg = log --pretty=format:'%Cred%h%Creset %C(bold blue)%an%Creset  %Cgreen(%cr) -%C(yellow)%d%Creset %s' --abbrev-commit --date=relative
	rs = restore
	rss = restore --staged
	rms = rm --staged
	track = add --intent-to-add
	diff-inline = diff --color-words
	recover = !~/.config/git/recover.sh
	new = !git init && gh repo create --private --source=. --remote=origin && git push -u --all
	filter-repo= !~/.config/git/filter-repo.py
[rerere]
	enabled = true
; [column]
; 	ui = auto
[branch]
	sort = -committerdate
	autoSetupMerge = simple

[include]
	path = ~/.lconfig/.gitconfig
[maintenance]
	repo = ~/projects/bot/server
	repo = ~/projects/bot/web
	repo = ~/.dotfiles
	repo = ~/projects/rialpayment
[push]
	autoSetupRemote = true
[fetch]
	writeCommitGraph = true
[rebase]
	updateRefs = true
[core]
	excludesfile = ~/.config/git/ignore
	fileMode = false
	; pager = delta
[interactive]
	diffFilter = delta --color-only
[grep]
	lineNumber = true
	patternType = perl
[init]
	defaultBranch = main

; [http]
; 	proxy = http://127.0.0.1:2080/
; [https]
; 	proxy = http://127.0.0.1:2080/
[pull]
	rebase = false
[credential]
	helper = cache
[pager]
	blame = delta
[delta]
	navigate = true
	line-numbers = true
	hyprlinks = true
	syntax-theme = Catppuccin Macchiato
; vim: ft=gitconfig
