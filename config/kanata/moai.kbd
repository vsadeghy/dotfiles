(defcfg
  linux-continue-if-no-devs-found yes
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 50
  danger-enable-cmd yes
)

;; keys to be used in the layers
(defsrc
  1 2 3 4 5   7 8 9  0 -
  q w e r t   u i o  p [
  a s d f g   j k l ︔ '
        b   ␣ v  n
;;      ␣🔣 ⇧ 🔢 ↑↓
)
(defchordsv2
  (t! crd (i o) ')
  (t! crd (s d) C-c)
  (t! crd (d f) C-v)
  (t! crd (s f) C-x)
  (t! crd (s d f) C-z)
  (t! crd (2 3) ⎋)
  (t! crd (9 0) ⌫)
  (t! crd (l ︔) ⌦)
  (t! crd (w e) ⏎)
  (t! crd (e r) ⭾)
  (t! crd (o p) ⏎)
  (t! crd (8 9) =)
)

(defvar
  tap-timeout 200
  hold-timeout 150
  hold-timeout-pinky 200
  hold-timeout-long 1000
  chord-timeout 30

  tt  $tap-timeout
  ht  $hold-timeout
  htp $hold-timeout-pinky
  htl $hold-timeout-long
  ct  $chord-timeout
  )

;; home (top) row mods
(defalias
  q (tap-hold $tt $htp (multi q u) q)
  s (tap-hold $tt $ht s ‹⎇)
  e (tap-hold $tt $ht e ‹⌃)
  f (tap-hold $tt $ht f ‹❖)
  j (tap-hold $tt $ht j ❖›)
  i (tap-hold $tt $ht i ⌃›)
  l (tap-hold $tt $ht l ⎇›)

  🖱️  (layer-switch mouse)
  🔠  (layer-switch base)
  🔢  (chord layers 🔢)
  ␣🔣 (chord layers ␣🔣)
  ↑↓  (chord layers ↑↓)
  ⇧   (chord layers ⇧)

  ⟳ rpt

  meh (multi ‹⌃ ‹⎇ ‹⇧)

  ⮸ (caps-word-custom $htl
      (a b c d e f g h i j k l m n o p q r s t u v w x y z)
      (⌫ ⌦ ▲ ◀ ▼ ▶)
  )
)
;;base layer is the first layer defined
(deflayer base
   q     w    @e     r     t     y     u    @i     o     p
   a    @s     d    @f     g     h    @j     k    @l    ︔
   z     x     c     v     b     n     m     ⸴     .     /
                    @␣🔣  @⇧    @🔢   @↑↓
)

(deftemplate crd (chord action)
  $chord $action $ct first-release (qwerty)
)
(deftemplate crdx (chord action except)
  $chord $action $ct first-release except
)
 
(defchords layers $ct
  (␣🔣) (tap-hold $tt $ht ␣ (layer-toggle symbols))
  (⇧) ‹⇧
  ;; (⇧) (tap-hold $tt $htl (one-shot 2000 ‹⇧) ‹⇧)
  (🔢) (layer-toggle numbers)
  (↑↓) (layer-toggle navigation)
  (␣🔣 ⇧) @meh
  (↑↓  ⇧) (tap-hold $tt $htl @⮸ ⇪)
)

(defalias
  !  S-1
  ＠ S-2
  ⌗  S-3
  $  S-4
  ٪  S-5
  ∧  S-6
  ＆ S-7
  ∗  S-8
 〔  S-9
  〕 S-0
  ˜  S-ˋ
  - (chord syms -)
  _  S-min
  ＋ (chord syms ＋)
  |  S-\
  ]  ]
  [  (chord syms [)
  ❴  S-[
  ❵  S-]
  :  S-;
  ⟨  S-,
  ⟩  S-.
  ?  S-⁄
  ”  (chord syms ”)
  ꞌ  '
)
(deflayer symbols
   •    @∗    @-    @＋    •     •    @∧    @$    @٪     •
  @”    @[    @〔   @❴     \    @⌗    @❵    @〕   @]    ︔
   •    @＆   @|    @!    @⟨    @⟩    @˜    @＠   @_     •
                     •     _    ‹⌃    •
)
(defchords syms $ct
  (”  ) S-'
  (  [) [
  (” [) `
  (-  ) -
  (  ＋) S-eql
  (- ＋) (macro = S-.) ;; =>
)

(platform (linux)
  (defalias
    fafn M-f7
    enfn M-f8
  )
)
(platform (win winiov2 wintercept)
  (defalias
    fafn A-S-7
    enfn A-S-8
  )
)

(defalias
  grp (tap-hold $tt $htl nop5 (multi (layer-switch graphite) @enfn))
  qwr (tap-hold $tt $htl nop5 (multi (layer-switch qwerty) @enfn))

  →↑↓ (layer-switch navigation)

  ;; fa @fafn
  fa (multi (layer-switch farsi) @fafn)
  en (multi (layer-switch base)  @enfn)
)

(deflayer navigation
   q    @fa   ‹⌃    @en   @qwr   ◀◀    ↖     ▲     ↘     ▶▶
  @🔠   ‹⎇    ‹⌃    ‹❖    @grp   🔉    ◀     ▼     ▶     🔊
   •     •     •    @→↑↓   •     ▶⏸    ⇞     o     ⇟     🔇
                    @🔢    @␣🔣   ␣   ‹⇧
)

(defalias
  1  (tap-hold $tt $htl 1    f1)
  2  (tap-hold $tt $htl 2    f2)
  3  (tap-hold $tt $htl 3    f3)
  4  (tap-hold $tt $htl 4    f4)
  5  (tap-hold $tt $htl 5    f5)
  6  (tap-hold $tt $htl 6    f6)
  7  (tap-hold $tt $htl 7    f7)
  8  (tap-hold $tt $htl 8    f8)
  9  (tap-hold $tt $htl 9    f9)
  br (tap-hold $tt $htl brk  f10)
  pr (tap-hold $tt $htl prnt f11)
  in (tap-hold $tt $htl ⎀    f12)
)
(deflayer numbers
   •    @∗     -    @＋    •    @in   @4    @5    @6     •
   .    ‹⎇    ‹⌃    ‹❖    @٪    @pr   @1    @2    @3     0
   •    @∧     ⸴     ⁄     •    @br   @7    @8    @9     •
                     _     ␣     =    @🖱️
)

(defalias
  ;; mousewheel: interval, distance
  wu (🖱☸↑ 50 120)
  wd (🖱☸↓ 50 120)
  wl (🖱☸← 50 480)
  wr (🖱☸→ 50 480)

  ;; movemouse-speed: percent
  s0 (🖱speed 25)
  s1 (🖱speed 150)
  s2 (🖱speed 250)

  ;; movemouse: interval, distance
  mu (🖱↑ 8 4)
  md (🖱↓ 8 4)
  ml (🖱← 8 4)
  mr (🖱→ 8 4)
  🔄🖱️ (layer-switch mouser)
)
(deflayer mouse
  @s2   @wu   @mu   @wd   @🔄🖱️  •     •    ‹⇧     •    @s2
  @s0   @ml   @md   @mr   mbtp   •    ‹❖    ‹⌃    ‹⎇    @s0
  @s1   mmid  @wl   @wr   mftp   •     •     •     •    @s1
                     @🔠  mrgt  mlft   •  
)
(deflayer mouser
  @s2    •    ‹⇧     •     •    @🖱️   @wd   @mu   @wu   @s2
  @s0   ‹⎇    ‹⌃    ‹❖     •    mbtp  @ml   @md   @mr   @s0
  @s1    •     •     •     •    mftp  @wl   @wr   mmid  @s1
                     @🔠  mrgt   •    mlft
)

(defalias
  lg  (tap-hold $tt $ht l ‹⎇)
  dg  (tap-hold $tt $ht d ‹⌃)
  wg  (tap-hold $tt $ht w ‹❖)
  fg  (tap-hold $tt $ht f ❖›)
  og  (tap-hold $tt $ht o ⌃›)
  ug  (tap-hold $tt $ht u ⎇›)
)
(deflayer graphite
   b    @lg   @dg   @wg    z     ;    @fg   @og   @ug    j
   n     r     t     s     g     y     h     a     e     i
   x     m     c     v     q     k     p     .     ,     /
                   @🔢     ␣    @↑↓   @⇧
)

(defalias
  ا  h
  ب  f
  پ  m
  ت  j
  ث  e
  ج  [
  چ  ]
  ح  p
  خ  o
  د  n
  ذ  b
  ر  v
  ز  c
  ژ  S-c
  س  s
  ش  a
  ص  w
  ض  q
  ط  x
  ظ  z
  ع  u
  غ  y
  ف  t
  ق  r
  ک (chord ge ک)
  گ  '
  ل  g
  م (chord ge م)
  ن  k
  و  ⸴
  ه  i
  ی  d
  ،  S-7
  .  (tap⬓↑  $tt $htp . @،)
  ̲   (tap-hold $tt $htl _ @🔠)
)
(deflayer farsi
  @ض    @ص    @ث    @ق    @ف    @غ    @ع    @ه    @خ    @ح
  @ش    @س    @ی    @ب    @ل    @ا    @ت    @ن    @م    @ک
  @ظ    @ط    @ز    @ر    @ذ    @د    @پ    @و    @.     /
                   @🔢    @␣🔣  @↑↓   @⇧
)
(defchords ge 15
  (م  )  l
  (  ک) ︔
  (م ک)  ' ;; گ
  ;; (خ  )  l
  ;; (  ح) ︔
  ;; (خ ح)  [ ;; گ
)

(deflayer qwerty
   _     _     _     _     _     _     _     _     _     _
   _     _     _     _     _     _     _     _     _     _
   _     _     _     _     _     _     _     _     _    @̲
                     _     _     _     _
)

